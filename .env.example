# Local bridge (Node 22+). Do not put secrets in VITE_* variables.
API_HOST=127.0.0.1
API_PORT=8787
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Use a gateway you control; never send account sessions to a random public gateway.
NETEASE_API_BASE_URL=

# Set only after checking a real report field, unit, and date coverage.
# Example path shape (not a real field): data.verifiedField
NETEASE_DURATION_PATH=
NETEASE_DURATION_UNIT=

# Optional compatible QQ gateway. Current research project has commercial-use restrictions.
QQ_API_BASE_URL=
QQ_QR_CHANNEL=qq

# Optional official personal-use connection. A key is entered for each browser session,
# never shared globally across visitors. Leave disabled for a public product.
ENABLE_QQ_PERSONAL_KEY=false

# Apple Music official MusicKit connection. Supply an already-signed ES256 developer JWT.
# Never put an Apple .p8 signing private key in frontend code or VITE_* variables.
# The browser receives this developer token for MusicKit; each user's music token stays server-side.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_APP_NAME=zmusicstats
