{
  "name": "zmusicstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "setup:netease": "node server/setup-netease.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/*.test.mjs",
    "setup:qq": "node server/setup-qq.mjs",
    "setup:apple": "node server/configure-apple.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.3",
    "@yakult-green-tea/qq-music-api": "3.3.8",
    "jsqr": "1.4.0",
    "lucide-react": "1.79.0",
    "motion": "14.14.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  }
}
